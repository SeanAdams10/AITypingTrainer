{
    "python.testing.pytestEnabled": true,
    "python.testing.unittestEnabled": false,
    "python.testing.nosetestsEnabled": false,
    "python.defaultInterpreterPath": "${workspaceFolder}/.venv/bin/python",

    "python.testing.pytestArgs": ["tests"],
    "python.envFile": "${workspaceFolder}/.env",

    // Enable Ruff everywhere in this workspace
    "ruff.enable": true,
    "ruff.nativeServer": "on",              // Use Rust LSP (fastest)
    "ruff.lineLength": 100,                 // Mirrors pyproject
    "ruff.lint.enable": true,               // Enable linting
    "ruff.showNotifications": "onError",    // Show notifications for errors
    
    // Python formatting and linting on save
    "[python]": {
        "editor.formatOnSave": true,
        "editor.defaultFormatter": "charliermarsh.ruff",
        "editor.codeActionsOnSave": {
            "source.fixAll": "explicit",        // Run Ruff fixes on save
            "source.organizeImports": "explicit" // Organize imports on save
        }
    },
    
    // Enable mypy type checking - appears in Problems tab
    "python.linting.enabled": true,
    "python.linting.mypyEnabled": true,
    "python.linting.lintOnSave": true,
    "python.linting.mypyArgs": [
        "--config-file=mypy.ini",
        "--show-column-numbers",
        "--show-error-codes"
    ],
    
    // Additional linting settings for Problems tab
    "python.linting.pylintEnabled": false,  // Disable pylint to avoid conflicts
    "python.languageServer": "Pylance",     // Use Pylance for better type checking integration
    
    "python-envs.pythonProjects": [
        {
            "path": "",
            "envManager": "ms-python.python:venv",
            "packageManager": "ms-python.python:pip"
        }
    ]
}
