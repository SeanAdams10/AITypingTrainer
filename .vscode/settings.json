{
    "python.testing.pytestEnabled": true,
    "python.testing.unittestEnabled": false,
    "python.testing.nosetestsEnabled": false,
    "python.defaultInterpreterPath": "${workspaceFolder}/.venv/Scripts/python.exe",
    "autopep8.interpreter": [
        "${workspaceFolder}/.venv/Scripts/python.exe"
    ],

    "python.testing.pytestArgs": [
        "tests"
    ],
    "python.envFile": "${workspaceFolder}/.env",

    // Enable Ruff everywhere in this workspace
    "ruff.enable": true,
    "ruff.nativeServer": "on",              // Use Rust LSP (fastest)
    "ruff.interpreter": ["${workspaceFolder}/.venv/Scripts/python.exe"],
    "ruff.lineLength": 100,                 // Mirrors pyproject
    "ruff.lint.enable": true,               // Enable linting
    
    // isort configuration
    "isort.interpreter": ["${workspaceFolder}/.venv/Scripts/python.exe"],
    
    // Mypy Type Checker configuration
    "mypy-type-checker.interpreter": ["${workspaceFolder}/.venv/Scripts/python.exe"],
    "mypy-type-checker.args": [
        "--config-file=mypy.ini",
        "--show-column-numbers",
        "--show-error-codes"
    ],
    
    // Python formatting and linting on save
    "[python]": {
        "editor.formatOnSave": true,
        "editor.defaultFormatter": "charliermarsh.ruff",
        "editor.codeActionsOnSave": {
            "source.fixAll": "explicit",        // Run Ruff fixes on save
            "source.organizeImports": "explicit" // Organize imports on save
        }
    },
    
    // Additional linting settings
    "python.linting.pylintEnabled": false,  // Disable pylint to avoid conflicts
    "python.languageServer": "Pylance",     // Use Pylance for better type checking integration
    
    "python-envs.pythonProjects": [
        {
            "path": "",
            "envManager": "ms-python.python:venv",
            "packageManager": "ms-python.python:pip"
        }
    ],
    "chat.tools.terminal.autoApprove": {
        "uv": true
    }
}
